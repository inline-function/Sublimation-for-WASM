// wasm.subs —— @wasm 宿主桥接处理器（wasm doc/Phase 0 验证记录.md）
//
// 职责：
//   1. @wasm 标注宿主桥接：@host 无体声明，函数体由壳工程 wasm-app/js/wasm-runtime.js
//      在 QuickJS-in-WASM 宿主里实现（产物 app.js 以裸名调用同名全局函数）。
//   2. 态度校验：白名单（防笔误：编译期报错而非运行期找不到全局函数）、
//      @host（无体合法性）、@impure（桥接有副作用）、无体。
//   3. 编译后阶段（@postcompile build）：把 JS 产物与 wasm 宿主组装成可部署物
//      （含 wasm 运行时 + app.js + html/node 装载器，见 package-wasm.ps1）。
// @postcompile build

fun checkFuns(xs: List[Str]): Null =
    when (xs) {
        Nil => null
        is Cons(f, rest) => { checkOne(f); checkFuns(rest) }
        else => null
    }

fun checkOne(fn: Str): Null {
    if (!funHasAnnotation(fn, "wasm")) null else {
        var anns: List[Str] = funAnnotations(fn);
        checkOp(fn);
        checkHost(fn);
        checkImpure(fn, anns);
        checkNoBody(fn)
    }
}

fun checkOp(fn: Str): Null {
    if (isWasmOp(fn)) null
    else processorError("@wasm 函数 " + fn + " 不在宿主桥 op 表内（op 名=声明的函数名）。op 表见 wasm doc/平台边界.md §1：wasmName/wasmTimeMs/wasmEnv、wasmStorage*(6)、wasmFetch(前瞻；println/print/getArgs/sleep 由编译器内建桥分派）")
}

fun checkHost(fn: Str): Null {
    if (funHasAnnotation(fn, "host")) null
    else processorError("@wasm 函数 " + fn + " 缺 @host：宿主桥的合法性来自 @host（无体声明，体由壳注入）")
}

fun checkImpure(fn: Str, anns: List[Str]): Null {
    if (containsAnno(anns, "impure")) null
    else processorWarn("@wasm 函数 " + fn + " 缺 @impure：宿主桥接有副作用")
}

fun checkNoBody(fn: Str): Null {
    if (funHasBody(fn)) processorError("@wasm 函数 " + fn + " 不应有函数体：实现位于壳的 wasm-runtime.js，此处声明即接口")
    else null
}

fun containsAnno(xs: List[Str], a: Str): Bool =
    when (xs) {
        Nil => false
        is Cons(h, rest) => if (startsWith(h, a)) true else containsAnno(rest, a)
        else => false
    }

fun isWasmOp(fn: Str): Bool =
    when (fn) {
        // 宿主信息与能力（app/wasm.subl；宿主 __subl.call 的 op 实现见 wasm-runtime.js）
        // 注：println/print/getArgs/sleep 由编译器内建桥分派（BRIDGE_OPS），不在此列
        "wasmName" => true
        "wasmTimeMs" => true
        "wasmEnv" => true
        // 存储 KV（app/storage.subl；宿主=进程内 Map，浏览器宿主=localStorage）
        "wasmStorageLoad" => true
        "wasmStorageStore" => true
        "wasmStorageHas" => true
        "wasmStorageRemove" => true
        "wasmStorageKeys" => true
        "wasmStorageClear" => true
        // 网络前瞻声明（app/net.subl；本阶段宿主报「不可用」，见平台边界.md）
        "wasmFetch" => true
        else => false
    }

// ---------- 编译后阶段：把 JS 产物拷进壳工程 ----------
// 期望编译参数（-A key=value）：
//   wasmApp=壳工程目录（含 build/package-wasm.ps1）；wasmJs=JS 产物路径；
//   wasmOut=输出目录（默认 wasmApp\\build\\wasm）。缺 wasmApp/wasmJs 时跳过。
// 键名避开 android 处理器的 appDir/jsPath/outDir/sdkDir 命名空间，便于共存。

fun build(): Null {
    var appDir: Str = optionOr("wasmApp", "")
    var jsPath: Str = optionOr("wasmJs", "")
    var outDir: Str = optionOr("wasmOut", appDir + "\\build\\wasm")
    if (appDir == "") processorInfo("wasm 打包：未给 wasmApp，跳过")
    else if (jsPath == "") processorInfo("wasm 打包：未给 wasmJs，跳过")
    else {
        var script: Str = appDir + "\\build\\package-wasm.ps1"
        if (!fileExists(script)) processorError("打包脚本不存在：" + script + "（wasmApp 应指向 wasm-app 壳工程目录）")
        else {
            processorInfo("wasm 打包开始：" + outDir)
            var res: Str = runShell("powershell -ExecutionPolicy Bypass -File \"" + script + "\" -JsPath \"" + jsPath + "\" -OutDir \"" + outDir + "\"")
            reportResult(res)
        }
    }
    null
}

fun reportResult(res: Str): Null {
    if (startsWith(res, "0|")) processorInfo("wasm 就绪：" + res)
    else processorError("wasm 打包失败：" + res)
    null
}

checkFuns(funNames(0))
